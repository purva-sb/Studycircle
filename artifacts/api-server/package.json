    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "livekit-server-sdk": "^2.15.3",
    "multer": "^2.1.1",
    "pino": "^9",
    "pino-http": "^10",
    "socket.io": "^4.8.3",
    "zod": "catalog:"
