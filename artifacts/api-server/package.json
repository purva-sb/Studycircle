{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx cross-env NODE_ENV=development pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
